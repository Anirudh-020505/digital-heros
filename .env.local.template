# IMPORTANT: This is a TEMPLATE
# Copy this file to .env.local and fill in YOUR actual values
# This file should be in the root directory: /digital-impact-golf-main/.env.local

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string (REQUIRED)
# Get this from Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres"

# ============================================
# PAYMENT PROVIDER - CHOOSE ONE
# ============================================

# OPTION 1: RAZORPAY (RECOMMENDED FOR INDIA) ✅
# Get keys from: https://razorpay.com/dashboard → Settings → API Keys
RAZORPAY_KEY_ID="rzp_live_1234567890abc"
RAZORPAY_KEY_SECRET="abc1234567890xyz"
RAZORPAY_WEBHOOK_SECRET="webhook_secret_from_razorpay_dashboard"

# OPTION 2: STRIPE (FOR INTERNATIONAL USERS)
# Get keys from: https://dashboard.stripe.com/keys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET="whsec_1234567890abc"

# Stripe product price IDs
# Create these in Stripe Dashboard → Products
# Format: price_1234567890abc
STRIPE_PRICE_MONTHLY_ID="price_monthly_1234567890"
STRIPE_PRICE_YEARLY_ID="price_yearly_1234567890"

# ============================================
# SUBSCRIPTION PRICING
# ============================================
# Monthly price in cents (default: $25 = 2500)
STRIPE_PRICE_MONTHLY=2500

# Yearly price in cents (default: $250 = 25000)
STRIPE_PRICE_YEARLY=25000

# Charity donation percentage (10% = 0.1)
CHARITY_POOL_PERCENTAGE=0.1

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL="https://[project-id].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ============================================
# AUTHENTICATION
# ============================================
# JWT secret key for signing tokens
# Generate a random string: openssl rand -hex 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Environment (development, staging, production)
NODE_ENV="development"

# Application URL
APP_URL="http://localhost:5173"

# API Base URL
VITE_API_URL="http://localhost:5173"

# ============================================
# LOGGING & MONITORING
# ============================================
# Sentry error tracking (optional)
SENTRY_DSN=""

# ============================================
# FEATURE FLAGS
# ============================================
# Enable test mode (use test payment cards)
TEST_MODE="true"

# Enable admin dashboard
ENABLE_ADMIN=true

# ============================================
# INSTRUCTIONS FOR EACH VARIABLE
# ============================================

# DATABASE_URL:
#   1. Go to https://app.supabase.com
#   2. Select your project
#   3. Settings → Database → Connection string
#   4. Copy the "Connection pooling" string
#   5. Replace [password] with your actual database password

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET:
#   1. Go to https://razorpay.com/dashboard
#   2. Settings → API Keys
#   3. Copy "Key ID" and "Key Secret"
#   4. Test mode keys start with "rzp_test_"
#   5. Live mode keys start with "rzp_live_"

# RAZORPAY_WEBHOOK_SECRET:
#   1. In Razorpay Dashboard, go to Settings → Webhooks
#   2. Create new webhook
#   3. URL: https://your-domain.com/api/webhooks/razorpay
#   4. Events: payment.authorized, payment.failed
#   5. Copy the webhook secret

# STRIPE_SECRET_KEY:
#   1. Go to https://dashboard.stripe.com/keys
#   2. Click "Reveal test key"
#   3. Copy the key starting with "sk_test_" or "sk_live_"

# STRIPE_PRICE_MONTHLY_ID:
#   1. Go to Stripe Dashboard → Products
#   2. Create product: "Monthly Golf Plan"
#   3. Set price to $25/month
#   4. Copy the Price ID (starts with "price_")

# SUPABASE_URL & VITE_SUPABASE_ANON_KEY:
#   1. Go to https://app.supabase.com
#   2. Project Settings → API
#   3. Copy "Project URL" and "anon public" key
#   4. Anon key starts with "eyJhbGciOi..."

# JWT_SECRET:
#   Generate random string:
#   $ openssl rand -hex 32
#   Copy the output

